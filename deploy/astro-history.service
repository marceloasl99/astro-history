# AstroHistory v6 — unidade systemd endurecida (NÃO aplicada automaticamente; ver deploy/README.md)
# Diferenças em relação ao serviço legado: usuário dedicado, bind em loopback (nginx faz o proxy),
# sandbox do systemd e sem access log (dados de nascimento do módulo pessoal viajam na query string).

[Unit]
Description=AstroHistory Web Platform v6 (loopback :8000, proxy via nginx)
After=network.target

[Service]
Type=simple
User=astro
Group=astro
WorkingDirectory=/home/astro
Environment=PYTHONUNBUFFERED=1
Environment=ASTRO_ENV=production
ExecStart=/home/astro/.venv/bin/uvicorn src.web.app:app --host 127.0.0.1 --port 8000 --workers 2 --no-access-log --proxy-headers --forwarded-allow-ips=127.0.0.1
Restart=always
RestartSec=3

# Sandbox
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/astro/data /home/astro/db
PrivateTmp=true
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=false
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
